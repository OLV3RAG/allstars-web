---
import { club } from '../data/club';

const [titulo, ...resto] = club.entrenador.nombre.split(' ');
const apellido = resto.join(' ');
---

<section id="entrenador" class="relative overflow-hidden bg-negro">
  <div class="atmosfera-estadio" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-[88rem] px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
    <div class="credencial" data-revelar>
      <div class="credencial-inner">
        <p class="transmision">// FORMACIÓN TÁCTICA · CUERPO TÉCNICO</p>
        <p class="mt-2 text-[0.7rem] font-bold uppercase tracking-[0.28em] text-dorado">Cuerpo técnico</p>
        <div class="credencial-cuerpo">
          <h2 class="entrenador-nombre titulo-festivo font-titulo font-extrabold uppercase italic">
            <span class="entrenador-titulo block">{titulo}</span>
            <span class="block">{apellido}</span>
          </h2>
          <p class="sello" data-revelar data-revelar-delay="90">
            {club.entrenador.cargo}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .credencial {
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgb(236 193 78 / 0.95),
      rgb(255 255 255 / 0.14) 38%,
      rgb(210 150 40 / 0.72) 100%
    );
    clip-path: polygon(18px 0, calc(100% - 18px) 0, 100% 18px, 100% calc(100% - 18px), calc(100% - 18px) 100%, 18px 100%, 0 calc(100% - 18px), 0 18px);
  }

  .credencial-inner {
    background:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px),
      radial-gradient(ellipse at 0% 0%, rgb(210 150 40 / 0.16), transparent 46%),
      #141414;
    background-size: 28px 28px, 28px 28px, auto, auto;
    padding: 1.35rem 1.2rem 1.45rem;
  }

  .credencial-cuerpo {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin-top: 0.85rem;
  }

  .entrenador-nombre {
    font-size: clamp(3.4rem, 13vw, 7.8rem);
    line-height: 0.78;
  }

  .entrenador-titulo {
    font-size: 0.42em;
    letter-spacing: 0.14em;
  }

  .sello {
    position: relative;
    display: grid;
    width: min(100%, 15.5rem);
    min-height: 5.4rem;
    align-self: flex-start;
    place-items: center;
    border: 2px solid #ecc14e;
    border-radius: 999px;
    background: rgb(10 10 10 / 0.45);
    padding: 0.75rem 1.1rem;
    box-shadow:
      inset 0 0 0 4px #141414,
      inset 0 0 0 6px rgb(236 193 78 / 0.75);
    font-family: var(--font-titulo);
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.05em;
    line-height: 0.95;
    text-align: center;
    text-transform: uppercase;
    color: #ecc14e;
  }

  .sello::before {
    content: '';
    position: absolute;
    inset: 0.35rem;
    border: 1px dashed rgb(236 193 78 / 0.55);
    border-radius: inherit;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .credencial-inner {
      padding: 1.8rem 2rem 1.9rem;
    }

    .credencial-cuerpo {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
    }

    .sello {
      margin-bottom: 0.45rem;
    }
  }
</style>
