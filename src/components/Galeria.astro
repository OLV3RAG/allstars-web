---
import galeria from '../data/galeria.json';

const { highlights, fotos } = galeria;
const videoSrc = highlights.videoUrl ? encodeURI(highlights.videoUrl) : '';
const visible = Boolean(videoSrc) || fotos.length > 0;
---

{
  visible && (
    <section id="galeria" class="galeria relative overflow-hidden border-t border-white/10 bg-[#0B0B0B]" data-galeria aria-labelledby="galeria-titulo">
      <div class="atmosfera-estadio" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[88rem] px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
        <div data-revelar>
          <p class="transmision">// MATCH HIGHLIGHTS</p>
          <h2 id="galeria-titulo" class="mt-3 max-w-4xl font-titulo text-[clamp(2.4rem,7vw,5rem)] font-extrabold uppercase italic leading-[0.84] text-white">
            Galería y highlights
          </h2>
        </div>

        {
          videoSrc && (
            <article class="highlight" data-revelar>
              <div class="highlight-copia">
                <p class="highlight-cat">{highlights.categoria}</p>
                <h3 class="highlight-titulo">{highlights.titulo}</h3>
                <p class="highlight-texto">{highlights.subtitulo}</p>
              </div>
              <figure class="highlight-marco">
                <video controls playsinline preload="metadata" src={videoSrc} aria-label={highlights.titulo}>
                  Tu navegador no puede reproducir este video.
                </video>
              </figure>
            </article>
          )
        }

        {
          fotos.length > 0 && (
            <ul class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
              {fotos.map((foto, index) => (
                <li data-revelar data-revelar-delay={index % 4 ? String(index * 40) : undefined}>
                  <button
                    type="button"
                    class="group relative aspect-square w-full overflow-hidden rounded-xl border border-white/10 bg-[#141414] text-left"
                    data-galeria-abrir
                    data-src={foto.src}
                    data-alt={foto.alt}
                    data-titulo={foto.titulo}
                    data-categoria={foto.categoria}
                    aria-label={`Ampliar: ${foto.titulo}. ${foto.alt}`}
                  >
                    <img
                      src={foto.src}
                      alt=""
                      width="800"
                      height="800"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition duration-300 group-hover:scale-105 group-focus-visible:scale-105"
                    />
                    <span class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-1 bg-black/65 px-3 text-center opacity-0 transition duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
                      <span class="font-titulo text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[#ECC14E]">{foto.categoria}</span>
                      <span class="font-titulo text-lg font-extrabold uppercase italic leading-none text-white">{foto.titulo}</span>
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <dialog class="galeria-modal" data-galeria-modal aria-labelledby="galeria-modal-titulo">
        <div class="galeria-panel" data-galeria-panel>
          <button type="button" class="galeria-cerrar" data-galeria-cerrar aria-label="Cerrar">
            ✕
          </button>
          <img data-galeria-foto alt="" />
          <div class="galeria-pie">
            <p class="galeria-cat" data-galeria-categoria></p>
            <h3 id="galeria-modal-titulo" class="galeria-nombre" data-galeria-titulo></h3>
            <p class="galeria-desc" data-galeria-descripcion></p>
          </div>
        </div>
      </dialog>
    </section>
  )
}

<script>
  const seccion = document.querySelector<HTMLElement>('[data-galeria]');
  const modal = seccion?.querySelector<HTMLDialogElement>('[data-galeria-modal]');
  const foto = seccion?.querySelector<HTMLImageElement>('[data-galeria-foto]');
  const titulo = seccion?.querySelector<HTMLElement>('[data-galeria-titulo]');
  const categoria = seccion?.querySelector<HTMLElement>('[data-galeria-categoria]');
  const descripcion = seccion?.querySelector<HTMLElement>('[data-galeria-descripcion]');
  const cerrar = seccion?.querySelector<HTMLButtonElement>('[data-galeria-cerrar]');

  if (seccion && modal && foto) {
    seccion.querySelectorAll<HTMLButtonElement>('[data-galeria-abrir]').forEach((boton) => {
      boton.addEventListener('click', () => {
        foto.src = boton.dataset.src || '';
        foto.alt = boton.dataset.alt || '';
        if (titulo) titulo.textContent = boton.dataset.titulo || '';
        if (categoria) categoria.textContent = boton.dataset.categoria || '';
        if (descripcion) descripcion.textContent = boton.dataset.alt || '';
        modal.showModal();
        cerrar?.focus();
      });
    });

    cerrar?.addEventListener('click', () => modal.close());

    modal.addEventListener('click', (evento) => {
      if (evento.target === modal) modal.close();
    });

    modal.addEventListener('close', () => {
      foto.removeAttribute('src');
      foto.alt = '';
    });
  }
</script>

<style>
  .galeria {
    scroll-margin-top: 5.5rem;
  }

  .highlight {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    align-items: center;
  }

  .highlight-cat,
  .galeria-cat {
    margin: 0;
    color: #ecc14e;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .highlight-titulo,
  .galeria-nombre {
    margin: 0.35rem 0 0;
    font-family: var(--font-titulo);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .highlight-titulo {
    font-size: clamp(1.8rem, 4vw, 3rem);
  }

  .highlight-texto,
  .galeria-desc {
    margin: 0.75rem 0 0;
    color: rgb(255 255 255 / 0.72);
    line-height: 1.5;
  }

  .highlight-marco {
    margin: 0 auto;
    width: min(100%, 22rem);
    overflow: hidden;
    border: 1px solid rgb(236 193 78 / 0.45);
    border-radius: 1.15rem;
    background: #000;
    box-shadow: 0 0 36px rgb(236 193 78 / 0.12);
  }

  .highlight-marco video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #000;
    object-fit: contain;
  }

  .galeria-modal {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 1.25rem;
    background: transparent;
    color: #fff;
  }

  .galeria-modal::backdrop {
    background: rgb(0 0 0 / 0.84);
  }

  .galeria-modal[open] {
    display: grid;
    place-items: center;
  }

  .galeria-panel {
    position: relative;
    width: min(100%, 56rem);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1rem;
    background: #0b0b0b;
  }

  .galeria-panel img {
    display: block;
    width: 100%;
    max-height: min(72vh, 46rem);
    object-fit: contain;
    background: #000;
  }

  .galeria-pie {
    padding: 1rem 1.1rem 1.15rem;
  }

  .galeria-nombre {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }

  .galeria-cerrar {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: rgb(10 10 10 / 0.72);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
  }

  .galeria-cerrar:hover {
    border-color: #ecc14e;
    color: #ecc14e;
  }

  @media (min-width: 900px) {
    .highlight {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2.5rem;
    }

    .highlight-marco {
      margin: 0;
    }
  }
</style>
