---
import { club, whatsappUrl } from '../data/club';

const whatsapp = whatsappUrl('Hola, quiero agendar una clase muestra gratis en All Stars FC');
---

<section id="contacto" class="relative overflow-hidden bg-negro">
  <div class="atmosfera-estadio" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-[88rem] px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
    <article class="ticket" data-revelar>
      <div class="ticket-cuerpo">
        <p class="ticket-kicker">Clase muestra</p>
        <h2 class="ticket-titulo font-titulo font-extrabold uppercase italic text-negro">
          Ven a conocer la cancha
        </h2>
        <p class="ticket-texto">
          La clase muestra es gratis. Escríbenos por Facebook para pedir informes de horarios y cómo acompañar a tu hija o
          hijo en la primera visita. Te responderemos por ese canal.
        </p>
        <div class="ticket-acciones">
          <a
            href={club.facebook}
            class="ticket-cta"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Contactar por Facebook</span>
          </a>
          {
            whatsapp && (
              <a href={whatsapp} class="ticket-cta ticket-cta-alt" rel="noopener noreferrer" target="_blank">
                <span>WhatsApp</span>
              </a>
            )
          }
        </div>
      </div>
      <div class="ticket-talon" aria-hidden="true">
        <p class="ticket-talon-kicker">Pase VIP</p>
        <p class="ticket-talon-titulo font-titulo">Clase muestra</p>
        <p class="ticket-talon-meta">{club.nombre} · {club.ciudadCorta}</p>
      </div>
    </article>
  </div>
</section>

<style>
  .ticket {
    display: grid;
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at 14px 0, #0a0a0a 7px, transparent 8px) left top / 28px 14px repeat-x,
      radial-gradient(circle at 14px 100%, #0a0a0a 7px, transparent 8px) left bottom / 28px 14px repeat-x,
      repeating-linear-gradient(-18deg, transparent 0 16px, rgb(10 10 10 / 0.045) 16px 17px),
      #ecc14e;
    color: #0a0a0a;
    box-shadow:
      0 0 0 1px rgb(210 150 40 / 0.65),
      0 22px 50px rgb(0 0 0 / 0.28);
  }

  .ticket-cuerpo {
    padding: 1.5rem 1.2rem 1.35rem;
  }

  .ticket-kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(10 10 10 / 0.7);
  }

  .ticket-titulo {
    margin-top: 0.7rem;
    max-width: 12ch;
    font-size: clamp(2.6rem, 8vw, 5.4rem);
    line-height: 0.82;
  }

  .ticket-texto {
    margin-top: 1.1rem;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.55;
    color: rgb(10 10 10 / 0.82);
  }

  .ticket-acciones {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1.45rem;
  }

  .ticket-cta {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    width: 100%;
    min-height: 3.6rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0a0a0a;
    padding: 0 1.6rem;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ecc14e;
  }

  .ticket-cta span {
    position: relative;
    z-index: 1;
  }

  .ticket-cta::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    background: linear-gradient(100deg, transparent, rgb(236 193 78 / 0.45), transparent);
    pointer-events: none;
    transform: translateX(-180%) skewX(-16deg);
  }

  .ticket-cta:hover,
  .ticket-cta:focus-visible {
    background: #141414;
    color: #fff;
  }

  .ticket-cta:hover::before,
  .ticket-cta:focus-visible::before {
    animation: ticket-brillo 0.7s ease;
  }

  .ticket-cta-alt {
    border: 2px solid #0a0a0a;
    background: transparent;
    color: #0a0a0a;
  }

  .ticket-cta-alt:hover,
  .ticket-cta-alt:focus-visible {
    background: #0a0a0a;
    color: #ecc14e;
  }

  .ticket-talon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px dashed rgb(10 10 10 / 0.28);
    padding: 1rem 1.2rem 1.1rem;
  }

  .ticket-talon::before,
  .ticket-talon::after {
    content: '';
    position: absolute;
    top: -0.7rem;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: #0a0a0a;
  }

  .ticket-talon::before {
    left: -0.7rem;
  }

  .ticket-talon::after {
    right: -0.7rem;
  }

  .ticket-talon-kicker,
  .ticket-talon-meta {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ticket-talon-titulo {
    font-size: 1.35rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.04em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  @keyframes ticket-brillo {
    0% {
      transform: translateX(-180%) skewX(-16deg);
    }
    100% {
      transform: translateX(380%) skewX(-16deg);
    }
  }

  @media (min-width: 640px) {
    .ticket-cuerpo {
      padding: 2rem 2rem 1.7rem;
    }

    .ticket-acciones {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .ticket-cta {
      width: auto;
    }

    .ticket-texto {
      font-size: 1.05rem;
    }
  }

  @media (min-width: 900px) {
    .ticket {
      grid-template-columns: minmax(0, 1fr) 11.5rem;
    }

    .ticket-talon {
      flex-direction: column;
      justify-content: center;
      border-top: 0;
      border-left: 1px dashed rgb(10 10 10 / 0.28);
      text-align: center;
    }

    .ticket-talon::before,
    .ticket-talon::after {
      left: -0.7rem;
      right: auto;
    }

    .ticket-talon::before {
      top: -0.7rem;
    }

    .ticket-talon::after {
      top: auto;
      bottom: -0.7rem;
    }

    .ticket-talon-titulo {
      font-size: 1.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket-cta::before {
      animation: none;
    }
  }
</style>
