---
import { club, edadesLabel, horarioInformado, inscripcionLabel, mensualidadLabel } from '../data/club';

const inscripcionBadge =
  club.costos.inscripcionMxn === 0 ? `Inscripción $${club.costos.inscripcionMxn}` : inscripcionLabel();
---

<section id="categorias" class="relative overflow-hidden bg-negro">
  <div class="atmosfera-estadio" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-[88rem] px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
    <div class="max-w-xl" data-revelar>
      <p class="transmision">// MATCHDAY · ENTRENAMIENTOS</p>
      <p class="text-[0.7rem] font-bold uppercase tracking-[0.28em] text-dorado">Categorías y horarios</p>
      <h2 class="titulo-festivo mt-3 font-titulo text-[clamp(2.3rem,7vw,4.4rem)] font-extrabold uppercase italic leading-[0.86]">
        Dos categorías.<br />Un mismo equipo.
      </h2>
      <p class="mt-4 text-white/70">
        {edadesLabel()}. Horario de entrenamiento: {horarioInformado()}
      </p>
    </div>

    <div class="fichas">
      {
        club.categorias.map((categoria, index) => (
          <article
            class:list={['ficha', categoria.acento === 'plata' ? 'ficha-plata' : 'ficha-oro']}
            data-revelar
            data-revelar-delay={index ? '80' : undefined}
          >
            <p class="ficha-kicker">Categoría</p>
            <p class="ficha-anio">{categoria.id}</p>
            <p class="ficha-nombre">{categoria.nombre}</p>
          </article>
        ))
      }
    </div>

    <div class="cronograma-bloque" data-revelar>
      <p class="cronograma-kicker">Entrenamiento</p>
      <div class="cronograma">
        {
          club.horarios.map((sesion) => (
            <article class="jornada">
              <p class="jornada-sede">
                <svg class="reloj" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
                  <path d="M12 8v4.2l2.6 1.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                </svg>
                {club.sede.nombre}
              </p>
              <p class="jornada-dia">{sesion.dia}</p>
              <p class="jornada-hora">{sesion.hora}</p>
            </article>
          ))
        }
      </div>
    </div>

    <article id="costos" class="membresia" data-revelar>
      <p class="membresia-kicker">Costos</p>
      <ul class="membresia-badges" aria-label="Costos">
        <li class="badge badge-principal">
          <span class="badge-cifra">{`$${club.costos.mensualidadMxn} / mes`}</span>
          <span class="badge-pie">{mensualidadLabel()}</span>
        </li>
        <li class="badge">
          <span class="badge-cifra">{inscripcionBadge}</span>
          <span class="badge-pie">{`$${club.costos.inscripcionMxn} de inscripción`}</span>
        </li>
        {
          club.costos.claseMuestraGratis && (
            <li class="badge">
              <span class="badge-cifra">Clase muestra gratis</span>
            </li>
          )
        }
      </ul>
    </article>
  </div>
</section>

<style>
  .fichas {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .ficha {
    position: relative;
    min-height: 13rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(20 20 20 / 0.86);
    padding: 1.35rem 1.2rem 1.15rem;
    clip-path: polygon(16px 0, calc(100% - 16px) 0, 100% 16px, 100% calc(100% - 16px), calc(100% - 16px) 100%, 16px 100%, 0 calc(100% - 16px), 0 16px);
    transition: border-color 200ms ease;
  }

  .ficha-oro {
    border-color: rgb(236 193 78 / 0.45);
    color: #ecc14e;
    box-shadow: inset 0 4px 0 #ecc14e;
  }

  .ficha-plata {
    border-color: rgb(192 192 192 / 0.4);
    color: #c0c0c0;
    box-shadow: inset 0 4px 0 #c0c0c0;
  }

  .ficha:hover {
    border-color: rgb(236 193 78 / 0.5);
  }

  .ficha-plata:hover {
    border-color: rgb(192 192 192 / 0.7);
  }

  .ficha::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 3.4rem;
    height: 0.85rem;
    background: #0a0a0a;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    transform: translateX(-50%);
  }

  .ficha-kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .ficha-anio {
    margin-top: 0.2rem;
    font-family: var(--font-titulo);
    font-size: clamp(5.2rem, 18vw, 8.2rem);
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.03em;
    line-height: 0.78;
    text-shadow: 0 12px 28px rgb(0 0 0 / 0.35);
  }

  .ficha-nombre {
    margin-top: 0.45rem;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .cronograma-bloque {
    margin-top: 0.75rem;
  }

  .cronograma-kicker {
    margin-bottom: 0.65rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }

  .cronograma {
    display: grid;
    gap: 0.75rem;
  }

  .jornada {
    border: 1px solid rgb(255 255 255 / 0.1);
    background:
      radial-gradient(circle at 0 0, rgb(236 193 78 / 0.08), transparent 42%),
      rgb(20 20 20 / 0.88);
    padding: 0.95rem 1.05rem 1rem;
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
  }

  .jornada-sede {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }

  .reloj {
    width: 0.95rem;
    height: 0.95rem;
    color: #ecc14e;
  }

  .jornada-dia {
    margin-top: 0.3rem;
    font-family: var(--font-titulo);
    font-size: 1.15rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ecc14e;
  }

  .jornada-hora {
    margin-top: 0.35rem;
    font-family: var(--font-titulo);
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.85rem, 5vw, 2.7rem);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    text-transform: uppercase;
    color: #fff;
  }

  .membresia {
    margin-top: 0.85rem;
    border: 1px solid rgb(236 193 78 / 0.55);
    background:
      radial-gradient(ellipse at 100% 0%, rgb(210 150 40 / 0.18), transparent 46%),
      rgb(20 20 20 / 0.92);
    padding: 1.2rem 1rem 1.1rem;
    clip-path: polygon(16px 0, calc(100% - 16px) 0, 100% 16px, 100% calc(100% - 16px), calc(100% - 16px) 100%, 16px 100%, 0 calc(100% - 16px), 0 16px);
  }

  .membresia-kicker {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #ecc14e;
  }

  .membresia-badges {
    display: grid;
    gap: 0.65rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .badge {
    display: flex;
    min-height: 5.1rem;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.2rem;
    border: 1px solid rgb(236 193 78 / 0.4);
    border-radius: 0.85rem;
    background: rgb(10 10 10 / 0.55);
    padding: 0.85rem 1rem;
  }

  .badge-principal {
    border-color: #ecc14e;
    background: #ecc14e;
    color: #0a0a0a;
  }

  .badge-cifra {
    font-family: var(--font-titulo);
    font-size: clamp(1.45rem, 4vw, 2.15rem);
    font-weight: 800;
    font-style: italic;
    line-height: 0.92;
    text-transform: uppercase;
    color: #fff;
  }

  .badge-principal .badge-cifra,
  .badge-principal .badge-pie {
    color: #0a0a0a;
  }

  .badge-pie {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.72);
  }

  @media (min-width: 768px) {
    .fichas,
    .cronograma,
    .membresia-badges {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .membresia {
      padding: 1.4rem 1.25rem 1.25rem;
    }

    .badge-principal {
      grid-column: 1 / -1;
    }

    .ficha {
      min-height: 16rem;
      padding: 1.6rem 1.7rem 1.35rem;
    }
  }

  @media (min-width: 1024px) {
    .membresia-badges {
      grid-template-columns: 1.35fr 1fr 1fr;
    }

    .badge-principal {
      grid-column: auto;
    }
  }
</style>
