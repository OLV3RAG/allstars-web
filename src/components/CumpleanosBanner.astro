---
import galeria from '../data/galeria.json';

const tarjetas = galeria.fotos.filter((foto) => foto.categoria === 'Cumpleaños All Stars');
---

{
  tarjetas.length > 0 && (
    <section id="cumpleanos" class="relative overflow-hidden border-t border-[#ECC14E]/20 bg-negro" aria-labelledby="cumpleanos-titulo">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute left-1/2 top-0 h-48 w-[36rem] -translate-x-1/2 bg-[radial-gradient(ellipse_at_center,rgb(236_193_78/0.16),transparent_70%)]"></div>
        <div class="absolute bottom-0 right-0 h-40 w-72 bg-[radial-gradient(ellipse_at_center,rgb(255_128_0/0.12),transparent_70%)]"></div>
      </div>
      <div class="relative mx-auto max-w-[88rem] px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
        <div class="mx-auto max-w-3xl text-center" data-revelar>
          <p class="inline-flex items-center rounded-full border border-[#ECC14E]/30 bg-[#ECC14E]/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-[#ECC14E]">
            🎂 Aniversario &amp; festejo · Familia All Stars ⚽
          </p>
          <h2 id="cumpleanos-titulo" class="titulo-festivo mt-4 font-titulo text-[clamp(2.2rem,6vw,4.2rem)] font-extrabold uppercase italic leading-[0.88]">
            ¡Feliz cumpleaños cracks!
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg">
            Hoy celebramos la vida y la pasión de nuestros jugadores que lo dejan todo en la cancha. ¡Que sigan los éxitos!
          </p>
        </div>

        <ul class="mx-auto mt-8 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2">
          {tarjetas.map((foto, index) => (
            <li data-revelar data-revelar-delay={index ? '80' : undefined}>
              <button
                type="button"
                class="group relative w-full overflow-hidden rounded-2xl border border-[#ECC14E]/20 bg-[#141414] text-left shadow-[0_18px_50px_rgb(0_0_0/0.45),0_0_28px_rgb(236_193_78/0.12)]"
                data-galeria-abrir
                data-src={encodeURI(foto.src)}
                data-alt={foto.alt}
                data-titulo={foto.titulo}
                data-categoria={foto.categoria}
                aria-label={`Ampliar: ${foto.titulo}. ${foto.alt}`}
              >
                <img
                  src={encodeURI(foto.src)}
                  alt=""
                  width="900"
                  height="1125"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-105 group-focus-visible:scale-105"
                />
                <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black via-black/75 to-transparent px-4 pb-4 pt-16 text-center">
                  <span class="block font-titulo text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[#ECC14E]">{foto.categoria}</span>
                  <span class="mt-1 block font-titulo text-2xl font-extrabold uppercase italic leading-none text-white">{foto.titulo}</span>
                  <span class="mt-1 block text-sm text-white/75">All Stars FC</span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  section {
    scroll-margin-top: 5.5rem;
  }
</style>
