---
import { Image } from 'astro:assets';
import escudo from '../../assets/logo/escudo.png';
import { club } from '../data/club';
import { imagenPortada, type Jugador } from '../lib/jugadores';
import Silueta from './Silueta.astro';

interface Props {
  jugadores?: Jugador[];
  modoDiseno?: boolean;
}

const { jugadores = [], modoDiseno = false } = Astro.props;
const retratos = modoDiseno ? jugadores.slice(0, 2) : jugadores.filter((jugador) => imagenPortada(jugador));
const total = 1 + retratos.length;
const categorias = club.categorias.map((categoria) => categoria.id).join(' · ');

function palabras(texto: string) {
  return texto.split(/(\s+)/);
}
---

<section
  id="inicio"
  class="hero relative flex flex-col overflow-x-clip bg-negro"
  data-hero
  tabindex="0"
  aria-roledescription="carrusel"
  aria-label="Presentación de All Stars FC"
>
  <div class="hero-atmosfera pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <svg class="hero-cancha" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g fill="none" stroke="white" stroke-width="2">
      <rect x="70" y="48" width="1060" height="604"></rect>
      <line x1="600" y1="48" x2="600" y2="652"></line>
      <circle cx="600" cy="350" r="92"></circle>
      <circle cx="600" cy="350" r="4" fill="white" stroke="none"></circle>
      <rect x="70" y="188" width="168" height="324"></rect>
      <rect x="962" y="188" width="168" height="324"></rect>
    </g>
  </svg>
  <div class="speed-lines pointer-events-none absolute inset-0 opacity-70"></div>
  <div class="hero-wipe pointer-events-none" data-hero-wipe hidden></div>

  <div class="hero-escenario">
    <div class="hero-figuras">
      <div class="hero-figure is-active" data-hero-figure>
        <div class="hero-podio">
          <div class="hero-foco halo-pulso" aria-hidden="true"></div>
          <div class="hero-suelo" aria-hidden="true"></div>
          <Image
            src={escudo}
            alt={`Escudo oficial de ${club.nombre}`}
            width={620}
            height={656}
            densities={[1, 1.5, 2]}
            fetchpriority="high"
            loading="eager"
            class="hero-escudo"
          />
        </div>
      </div>

      {
        retratos.map((jugador) => {
          const foto = imagenPortada(jugador);
          const acento = jugador.categoria === '2013' ? 'plata' : 'dorado';
          return (
            <div class:list={['hero-figure', `acento-${acento}`]} data-hero-figure>
              <div class:list={['hero-halo', acento === 'plata' ? 'halo-plata' : 'halo-dorado']}></div>
              <p class="hero-numero" aria-hidden="true">
                {jugador.numero}
              </p>
              <div class="hero-persona">
                {foto ? (
                  <Image
                    src={foto}
                    alt=""
                    width={720}
                    height={900}
                    loading="lazy"
                    class="hero-foto"
                    style={jugador.encuadrePortada ? `object-position: ${jugador.encuadrePortada}` : undefined}
                  />
                ) : (
                  <Silueta variante="retrato" acento={acento} class="h-[min(70vw,26rem)] w-auto lg:h-[34rem]" />
                )}
              </div>
              <Image src={escudo} alt="" width={72} height={76} loading="lazy" class="hero-mini-escudo" />
            </div>
          );
        })
      }
    </div>

    <div class="hero-onair">
      <div class="hero-pill-wrap">
        <p class="hero-pill" data-hero-block>
          <span class="hero-live" aria-hidden="true"></span>
          <span class="hero-pill-texto">Temporada 2026 · Academia oficial</span>
        </p>
      </div>
      <div class="hero-copies">
        <div class="hero-copy is-active" data-hero-copy>
          <p class="hero-kicker" data-hero-block>
            {club.nombre} · {club.ciudadCorta.toUpperCase()}
          </p>
          <h1 class="hero-titulo font-titulo font-extrabold uppercase italic tracking-tight text-white">
            <span class="block">
              {
                palabras('El talento se entrena.').map((parte) =>
                  parte.trim() ? (
                    <span class="hero-palabra" data-hero-word>
                      {parte}
                    </span>
                  ) : (
                    parte
                  ),
                )
              }
            </span>
            <span class="mt-1 block">
              {
                palabras('El equipo se construye.').map((parte) =>
                  parte.trim() ? (
                    <span class="hero-palabra hero-metal" data-hero-word>
                      {parte}
                    </span>
                  ) : (
                    parte
                  ),
                )
              }
            </span>
          </h1>
          <p class="hero-lema" data-hero-block>
            “{club.lema}”
          </p>
        </div>

        {
          retratos.map((jugador) => (
            <div class="hero-copy" data-hero-copy>
              <p class:list={['hero-kicker', jugador.categoria === '2013' ? 'text-plata' : 'text-dorado']}>
                {club.nombre} · Categoría {jugador.categoria}
              </p>
              <p class="hero-titulo font-titulo font-extrabold uppercase italic text-white" data-hero-nombre>
                {
                  palabras(jugador.nombre).map((parte) =>
                    parte.trim() ? (
                      <span class="hero-palabra" data-hero-blur>
                        {parte}
                      </span>
                    ) : (
                      parte
                    ),
                  )
                }
              </p>
              <p class:list={['mt-3 font-titulo text-2xl font-bold uppercase', jugador.categoria === '2013' ? 'text-plata' : 'text-dorado']}>
                {jugador.posicion} · {jugador.numero}
              </p>
            </div>
          ))
        }
      </div>

      <div class="hero-acciones">
        <a href="#contacto" class="cta-principal bg-[#ECC14E] font-bold uppercase tracking-wider text-negro">
          <span class="cta-principal-label">Agenda tu clase gratis</span>
        </a>
        <a
          href={modoDiseno || retratos.length ? '#roster' : '#el-club'}
          class="cta-secundario"
        >
          Conoce al equipo
        </a>
      </div>
      <ul class="hero-stats" aria-label="Información rápida">
        <li class="hero-stat">
          <p class="hero-stat-valor">{`$${club.costos.mensualidadMxn}`}<span> MXN</span></p>
          <p class="hero-stat-label">Mensualidad</p>
        </li>
        <li class="hero-stat">
          <p class="hero-stat-valor">{`$${club.costos.inscripcionMxn}`}</p>
          <p class="hero-stat-label">Inscripción</p>
        </li>
        <li class="hero-stat">
          <p class="hero-stat-valor">{club.edadesDesde}+<span> años</span></p>
          <p class="hero-stat-label">Categorías</p>
          <p class="hero-stat-nota">{categorias}</p>
        </li>
      </ul>
    </div>

  {
    total > 1 && (
      <div class="hero-controles" data-hero-controls>
        <button type="button" class="hero-ctrl" data-hero-prev>
          <span class="hero-ctrl-inner" data-magnet>Anterior</span>
        </button>
        <button type="button" class="hero-ctrl" data-hero-pause aria-pressed="false">
          Pausar
        </button>
        <button type="button" class="hero-ctrl" data-hero-next>
          <span class="hero-ctrl-inner" data-magnet>Siguiente</span>
        </button>
        <div class="ml-auto flex gap-2" role="tablist" aria-label="Diapositivas">
          {Array.from({ length: total }).map((_, i) => (
            <button
              type="button"
              class="hero-dot"
              data-hero-dot
              aria-label={`Ir a la diapositiva ${i + 1}`}
              aria-current={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>
        <p class="sr-only" data-hero-status aria-live="polite">
          Diapositiva 1 de {total}
        </p>
      </div>
    )
  }

  </div>
</section>

<script>
  import { iniciarHeroSlider } from '../scripts/hero-slider';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) iniciarHeroSlider(hero);
</script>

<style>
  .hero:focus-visible {
    outline-offset: -4px;
  }

  .hero-atmosfera {
    background:
      radial-gradient(ellipse 70% 62% at 50% 22%, rgb(210 150 40 / 0.32) 0%, rgb(210 150 40 / 0.1) 32%, transparent 68%),
      radial-gradient(ellipse 28% 24% at 12% 88%, rgb(236 193 78 / 0.08), transparent 70%);
  }

  .hero-cancha {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.08;
    pointer-events: none;
  }

  .hero-pill-wrap {
    position: relative;
    z-index: 30;
    padding: 0 0 0.85rem;
  }

  .hero-pill {
    display: flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid rgb(236 193 78 / 0.45);
    border-radius: 999px;
    background: rgb(20 20 20 / 0.82);
    padding: 0.42rem 0.9rem 0.42rem 0.7rem;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
    color: #fff;
    backdrop-filter: blur(10px);
  }

  .hero-pill-texto {
    min-width: 0;
  }

  .hero-live {
    width: 0.48rem;
    height: 0.48rem;
    flex: none;
    border-radius: 999px;
    background: #ecc14e;
    box-shadow: 0 0 0 0 rgb(236 193 78 / 0.65);
  }

  .hero-escenario {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1rem 1.5rem;
  }

  .hero-figuras {
    position: relative;
    display: grid;
    place-items: center;
    overflow: visible;
  }

  .hero-onair {
    position: relative;
    z-index: 20;
    min-width: 0;
    padding: 0;
  }

  .hero-copies {
    display: grid;
  }

  .hero-copy,
  .hero-figure {
    grid-area: 1 / 1;
  }

  .hero:not([data-ready]) .hero-copy:not(.is-active),
  .hero:not([data-ready]) .hero-figure:not(.is-active) {
    position: relative;
    grid-area: auto;
    margin-top: 2rem;
  }

  .hero[data-ready] .hero-copy:not(.is-active),
  .hero[data-ready] .hero-figure:not(.is-active) {
    pointer-events: none;
  }

  .hero-figure {
    position: relative;
    display: grid;
    width: 100%;
    place-items: center;
  }

  .hero-podio {
    position: relative;
    display: grid;
    width: min(100%, 260px);
    place-items: center;
  }

  .hero-foco {
    position: absolute;
    z-index: 0;
    inset: 8% 0 18%;
    background: radial-gradient(circle, rgb(210 150 40 / 0.55) 0%, rgb(210 150 40 / 0.16) 42%, transparent 70%);
    filter: blur(48px);
    pointer-events: none;
  }

  .hero-suelo {
    position: absolute;
    z-index: 1;
    right: 8%;
    bottom: 1%;
    left: 8%;
    height: 1.15rem;
    border-radius: 999px;
    background: radial-gradient(ellipse at center, rgb(210 150 40 / 0.75) 0%, rgb(10 10 10 / 0.55) 55%, transparent 72%);
    filter: blur(5px);
    pointer-events: none;
  }

  .hero-escudo {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .hero-kicker {
    margin-bottom: 0.7rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #ecc14e;
  }

  .hero-titulo {
    font-size: clamp(2.4rem, 12vw, 4.4rem);
    line-height: 0.86;
  }

  .hero-lema {
    margin-top: 1rem;
    max-width: 22rem;
    font-size: 0.98rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.78);
  }

  .hero-acciones {
    position: relative;
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 1.35rem;
  }

  .hero-halo {
    position: absolute;
    inset: -8%;
    pointer-events: none;
  }

  .halo-dorado {
    background:
      radial-gradient(circle at 50% 40%, rgb(236 193 78 / 0.42) 0%, rgb(210 150 40 / 0.14) 32%, transparent 60%);
  }

  .halo-plata {
    background: radial-gradient(circle at 50% 40%, rgb(192 192 192 / 0.38) 0%, rgb(192 192 192 / 0.1) 32%, transparent 60%);
  }

  .hero-numero {
    position: absolute;
    z-index: 1;
    font-family: var(--font-titulo);
    font-size: clamp(7rem, 22vw, 14rem);
    font-weight: 800;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 2px rgb(236 193 78 / 0.35);
  }

  .acento-plata .hero-numero {
    -webkit-text-stroke: 2px rgb(192 192 192 / 0.4);
  }

  .hero-persona {
    position: relative;
    z-index: 2;
    display: flex;
    height: min(70vw, 26rem);
    align-items: flex-end;
    overflow: visible;
  }

  .hero-foto {
    height: 118%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: top center;
  }

  .hero-mini-escudo {
    position: absolute;
    right: 8%;
    bottom: 8%;
    z-index: 3;
    width: 3.2rem;
    height: auto;
    opacity: 0.9;
  }

  .hero-wipe {
    position: absolute;
    inset: -20% -10%;
    z-index: 15;
    background: linear-gradient(115deg, transparent 20%, rgb(236 193 78 / 0.22) 50%, transparent 80%);
  }

  .hero-palabra {
    display: inline-block;
  }

  .hero-metal {
    background-image: linear-gradient(90deg, #ecc14e 0%, #fff3b0 48%, #d29628 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .cta-principal,
  .cta-secundario {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0 1.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cta-principal {
    position: relative;
    isolation: isolate;
    min-height: 3.4rem;
    overflow: hidden;
    background: linear-gradient(180deg, #f6d56a 0%, #ecc14e 46%, #d29628 100%);
    color: #0a0a0a;
    clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);
    filter: drop-shadow(0 0 25px rgb(236 193 78 / 0.35));
    transition:
      transform 200ms ease,
      filter 200ms ease,
      background-color 200ms ease;
  }

  .cta-principal-label {
    position: relative;
    z-index: 1;
  }

  .cta-principal::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: 0;
    bottom: 0;
    left: 0;
    width: 42%;
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.72), transparent);
    pointer-events: none;
    transform: translateX(-180%) skewX(-16deg);
  }

  .cta-secundario {
    border: 1px solid rgb(255 255 255 / 0.7);
    color: #fff;
  }

  .cta-secundario:hover,
  .cta-secundario:focus-visible {
    border-color: #ecc14e;
    color: #ecc14e;
  }

  .cta-principal:hover,
  .cta-principal:focus-visible {
    filter: drop-shadow(0 14px 22px rgb(236 193 78 / 0.5));
    transform: translateY(-2px);
  }

  .cta-principal:hover::before,
  .cta-principal:focus-visible::before {
    animation: shine 0.75s ease;
  }

  .hero-stats {
    position: relative;
    z-index: 24;
    display: grid;
    gap: 0.7rem;
    margin: 1.35rem 0 0;
    list-style: none;
    padding: 0;
  }

  .hero-stat {
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(20 20 20 / 0.9);
    padding: 0.85rem 0.95rem 0.8rem;
    backdrop-filter: blur(12px);
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
    transition: border-color 200ms ease;
  }

  .hero-stat:hover {
    border-color: rgb(236 193 78 / 0.5);
  }

  .hero-stat-label {
    margin-top: 0.15rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ecc14e;
  }

  .hero-stat-valor {
    font-family: var(--font-titulo);
    font-size: clamp(2.15rem, 6.4vw, 3rem);
    font-weight: 800;
    font-style: italic;
    line-height: 0.86;
    text-transform: uppercase;
    color: #fff;
  }

  .hero-stat-valor span {
    font-size: 0.48em;
    letter-spacing: 0.06em;
  }

  .hero-stat-nota {
    margin-top: 0.15rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.72);
  }

  .hero-stat-valor .hero-stat-nota {
    margin-top: 0;
    margin-left: 0.35rem;
    font-family: var(--font-cuerpo);
    font-size: 0.95rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .hero-controles {
    position: relative;
    z-index: 25;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 1rem;
  }

  .hero-ctrl {
    min-height: 2.5rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    padding: 0 0.9rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-ctrl-inner {
    display: inline-block;
    transition: transform 160ms ease-out;
  }

  .hero-ctrl:hover,
  .hero-dot[aria-current='true'] {
    border-color: #ecc14e;
    color: #ecc14e;
  }

  .hero-dot {
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
  }

  @keyframes escudo-flota {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.625rem);
    }
  }

  @keyframes hero-live-pulso {
    0% {
      box-shadow: 0 0 0 0 rgb(236 193 78 / 0.6);
    }
    70% {
      box-shadow: 0 0 0 7px rgb(236 193 78 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(236 193 78 / 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-live {
      animation: hero-live-pulso 1.8s ease-out infinite;
    }

    .hero-escudo {
      animation: escudo-flota 4.8s ease-in-out infinite;
    }
  }

  @media (min-width: 640px) {
    .hero-pill {
      font-size: 0.68rem;
      letter-spacing: 0.16em;
    }

    .hero-acciones {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 768px) {
    .hero-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .hero-atmosfera {
      background:
        radial-gradient(ellipse 42% 58% at 72% 48%, rgb(210 150 40 / 0.22) 0%, transparent 68%),
        radial-gradient(ellipse 24% 30% at 18% 78%, rgb(236 193 78 / 0.07), transparent 72%);
    }

    .hero-escenario {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.9fr);
      align-items: center;
      gap: 1.5rem 2rem;
      min-height: calc(100svh - 4.25rem);
      padding: 2rem 2.5rem 2.25rem;
    }

    .hero-figuras {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
    }

    .hero-onair {
      grid-column: 1;
      grid-row: 1;
      max-width: 40rem;
    }

    .hero-podio {
      width: min(100%, 420px);
    }

    .hero-controles {
      grid-column: 1;
      padding: 0;
    }

    .hero-titulo {
      font-size: clamp(3.2rem, 5.2vw, 5rem);
    }

    .hero-lema {
      max-width: 26rem;
      font-size: 1.1rem;
    }

    .hero-persona {
      height: auto;
      max-height: min(68vh, 32rem);
    }

    .hero-foto {
      height: auto;
      max-height: min(68vh, 32rem);
    }
  }

  @media (min-width: 1280px) {
    .hero-podio {
      width: min(100%, 480px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-principal,
    .cta-principal::before,
    .hero-ctrl-inner,
    .hero-live,
    .hero-escudo {
      animation: none;
      transition: none;
    }

    .cta-principal:hover,
    .cta-principal:focus-visible,
    .hero-stat:hover {
      transform: none;
    }
  }
</style>
